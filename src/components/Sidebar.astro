---
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { person, l, type Lang } from '../data/profile';
import { ui, localePath } from '../data/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'es' ? 'en' : 'es';
const hasCv = existsSync(join(process.cwd(), 'public', person.cvPath));
const sections = ['about', 'experience', 'projects', 'skills', 'education', 'contact'] as const;
---

<header class="sidebar">
  <div class="intro">
    <h1 class="name">{person.name}</h1>
    <p class="role">{l(person.role, lang)}</p>
    <p class="tagline">{l(person.tagline, lang)}</p>
  </div>

  <nav class="nav" aria-label={lang === 'es' ? 'Secciones' : 'Sections'}>
    <ul>
      {
        sections.map((id) => (
          <li>
            <a href={`#${id}`} data-nav={id}>
              <span class="nav-line" aria-hidden="true" />
              <span>{t.nav[id]}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="actions">
    {
      hasCv && (
        <a class="cv" href={person.cvPath} download>
          {t.cv}
        </a>
      )
    }
    <ul class="social">
      <li>
        <a href={person.links.github} aria-label="GitHub" target="_blank" rel="me noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"/></svg>
        </a>
      </li>
      <li>
        <a href={person.links.linkedin} aria-label="LinkedIn" target="_blank" rel="me noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
        </a>
      </li>
      <li>
        <a href={`mailto:${person.email}`} aria-label={`Email: ${person.email}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M3 5.5h18v13H3z M3.5 6l8.5 7 8.5-7"/></svg>
        </a>
      </li>
    </ul>
    <div class="prefs">
      <a href={localePath(other)} hreflang={other} lang={other} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
      <button type="button" class="theme" aria-label={t.themeLabel}>
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><path stroke="currentColor" stroke-width="1.8" stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z"/></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .sidebar {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .name {
    font-size: var(--step-4);
    font-weight: 650;
    letter-spacing: -0.03em;
  }

  .role {
    margin-top: 0.4rem;
    font-size: var(--step-1);
    color: var(--accent);
  }

  .tagline {
    margin-top: 1rem;
    max-width: 30ch;
    color: var(--muted);
  }

  .nav {
    display: none;
  }

  .nav a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.45rem 0;
    color: var(--muted);
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .nav-line {
    width: 2rem;
    height: 1px;
    background: currentColor;
    transition: width 0.2s ease;
  }

  .nav a:hover,
  .nav a[aria-current='true'] {
    color: var(--text-strong);
  }

  .nav a:hover .nav-line,
  .nav a[aria-current='true'] .nav-line {
    width: 4rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 1.5rem;
  }

  .cv {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .cv:hover {
    background: var(--accent-soft);
  }

  .social {
    display: flex;
    gap: 1rem;
  }

  .social a {
    display: block;
    color: var(--muted);
  }

  .social a:hover {
    color: var(--text-strong);
  }

  .social svg {
    width: 1.35rem;
    height: 1.35rem;
    display: block;
  }

  .prefs {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: var(--step--1);
  }

  .prefs a {
    color: var(--muted);
  }

  .prefs a:hover {
    color: var(--text-strong);
  }

  .theme {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  .theme:hover {
    color: var(--text-strong);
    background: var(--surface);
  }

  .theme svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .theme .moon,
  :global([data-theme='light']) .theme .sun {
    display: none;
  }

  :global([data-theme='light']) .theme .moon {
    display: block;
  }

  @media (min-width: 64em) {
    .sidebar {
      position: sticky;
      top: 0;
      height: 100vh;
      padding: 6rem 0;
      justify-content: space-between;
    }

    .nav {
      display: block;
    }

    .actions {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>

<script>
  const root = document.documentElement;
  document.querySelector('.theme')?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-nav]')].map((a) => [a.dataset.nav, a]),
  );
  const setActive = (id?: string) => {
    links.forEach((a) => a.removeAttribute('aria-current'));
    if (id) links.get(id)?.setAttribute('aria-current', 'true');
  };
  let current: string | undefined;
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) if (entry.isIntersecting) current = entry.target.id;
      setActive(atBottom() ? lastId : current);
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  links.forEach((_, id) => {
    const section = id && document.getElementById(id);
    if (section) observer.observe(section);
  });

  const atBottom = () => window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
  const lastId = [...links.keys()].at(-1);
  window.addEventListener(
    'scroll',
    () => {
      setActive(atBottom() ? lastId : current);
    },
    { passive: true },
  );
</script>
