---
import Base from '../layouts/Base.astro';
---

<Base lang="es" noindex>
  <main id="main" class="missing">
    <p class="code">404</p>
    <h1>Esta página no existe.</h1>
    <p lang="en">This page does not exist.</p>
    <p class="links"><a href="/">Ir al inicio</a> <a href="/en/" lang="en">Go to the home page</a></p>
  </main>
</Base>

<style>
  .missing {
    max-width: 36rem;
    margin: 0 auto;
    padding: 20vh 1rem 4rem;
    display: grid;
    gap: 0.75rem;
  }

  .code {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: var(--step-2);
  }

  h1 {
    font-size: var(--step-3);
  }

  p {
    margin: 0;
  }

  .links {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-weight: 600;
  }
</style>
